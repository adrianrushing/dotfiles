#!/bin/sh

set -eu

theme_root="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
current="$theme_root/current"

current_mode() {
  target=$(readlink "$current" 2>/dev/null || true)
  case "$target" in
    light|*/light) printf '%s\n' light ;;
    *) printf '%s\n' dark ;;
  esac
}

requested=${1:-toggle}
case "$requested" in
  toggle)
    if [ "$(current_mode)" = dark ]; then
      mode=light
    else
      mode=dark
    fi
    ;;
  light|dark) mode=$requested ;;
  status)
    current_mode
    exit 0
    ;;
  *)
    printf 'Usage: theme-toggle [light|dark|toggle|status]\n' >&2
    exit 2
    ;;
esac

if [ ! -d "$theme_root/$mode" ]; then
  printf 'theme-toggle: missing theme directory: %s\n' "$theme_root/$mode" >&2
  exit 1
fi

ln -sfn "$mode" "$current"

# Keep Pi's foreground palette aligned with the terminal background.
pi_settings="$HOME/.pi/agent/settings.json"
if [ -f "$pi_settings" ]; then
  PI_THEME_MODE="$mode" perl -0pi -e 's/("theme"\s*:\s*)"[^"]*"/$1"$ENV{PI_THEME_MODE}"/' "$pi_settings"
fi

# Reload every tmux client through the shared server, if one is running.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
fi

# Ghostty 1.2+ reloads its configuration on SIGUSR2.
if command -v pkill >/dev/null 2>&1; then
  pkill -USR2 -x ghostty >/dev/null 2>&1 || true
fi

printf 'TokyoNight mode: %s\n' "$mode"
